# Copy this file to .env (which git ignores) and fill in ONE of the two options.
# Never commit .env or paste its values into chats, issues or screenshots.

# Option A (recommended): a model deployed in Microsoft Foundry (ai.azure.com)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Option B (fallback): GitHub Models, with a fine-grained token that has "Models: read"
GITHUB_TOKEN=
